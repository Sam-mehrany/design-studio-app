# Copy this file to .env (same folder) and fill it in. .env is git-ignored — keep it that way.

# Which model analyses the images: ollama (local, free) or claude (Claude API, paid per use)
AGENT_PROVIDER=ollama

# Your live vault. On your Windows PC that is the folder the studio uses:
DESIGN_VAULT=D:\Memory\design

# --- Local model (Ollama) ---
OLLAMA_MODEL=qwen3-vl:8b
OLLAMA_HOST=http://127.0.0.1:11434
# Context window in tokens. The system prompt alone is ~12k; 32k leaves room for the conversation.
OLLAMA_NUM_CTX=32768

# --- Claude API --- (only needed when AGENT_PROVIDER=claude or for --compare)
# Create a key at https://console.anthropic.com/settings/keys and paste it here, never in chat or code.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max — how hard Claude thinks per turn. high is a good default here.
CLAUDE_EFFORT=high

# --- Behaviour ---
# Max images analysed per run (protects your bill / your evening if 200 pins appear at once)
AGENT_MAX_PINS=10
# Commit new records in the vault's git repo after a run (1) or not (0). Push as well (1) or not (0).
AGENT_GIT_COMMIT=1
AGENT_GIT_PUSH=0
# Vocabulary detail in the prompt: full (term + definition) or names (smaller, for small local models)
AGENT_VOCAB=full
