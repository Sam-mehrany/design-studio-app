{
  "name": "design-studio",
  "productName": "Design Studio",
  "version": "1.0.0",
  "description": "Browse, classify and link your design reference library.",
  "main": "main.js",
  "author": "Sam Mehrany",
  "license": "MIT",
  "scripts": {
    "sync": "node sync-server.js",
    "pinterest": "node design/tools/pinterest-sync.js",
    "start": "npm run sync && electron .",
    "serve": "npm run sync && node server/studio.js --port 7391",
    "dist": "npm run sync && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.sammehrany.designstudio",
    "productName": "Design Studio",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "server/**/*", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Design Studio"
    }
  }
}
